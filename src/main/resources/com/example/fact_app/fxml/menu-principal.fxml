<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fact_app.controller.MenuPrincipalController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Archivo">
            <items>
              <MenuItem fx:id="menuItemSalir" mnemonicParsing="false" onAction="#onSalirClick" text="Salir">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/cerrar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </MenuItem>
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Catálogos">
            <items>
              <MenuItem fx:id="menuItemProductos" mnemonicParsing="false" onAction="#onAbrirProductosClick" text="Productos" />
                  <MenuItem fx:id="menuItemCargos" mnemonicParsing="false" onAction="#onAbrirCargosClick" text="Cargos" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ayuda">
            <items>
              <MenuItem fx:id="menuItemAcercaDe" mnemonicParsing="false" onAction="#onAcercaDeClick" text="Acerca de" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="95.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo.png" />
               </image>
            </ImageView>
            <Label text="Sistema de Facturación" textFill="#1f2937">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Label text="Seleccione un módulo para gestionar" textFill="#4b5563">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <Separator maxWidth="540.0" />
            <HBox alignment="CENTER" spacing="25.0">
               <children>
                  <Button fx:id="btnProductos" mnemonicParsing="false" onAction="#onAbrirProductosClick" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand; -fx-background-radius: 8;" text="Productos" />
                  <Button fx:id="btnCargos" mnemonicParsing="false" onAction="#onAbrirCargosClick" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand; -fx-background-radius: 8;" text="Cargos" />
                  <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#onSalirClick" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #b91c1c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand; -fx-background-radius: 8;" text="Salir">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/cerrar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" style="-fx-background-color: #e5e7eb;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Fact_App - Programación de Aplicaciones de Escritorio" textFill="#6b7280">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
