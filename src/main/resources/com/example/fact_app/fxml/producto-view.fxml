<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="680.0" prefWidth="820.0" spacing="14.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fact_app.controller.ProductoController">
    <children>
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Productos" textFill="#1f2937">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Separator />
        <GridPane hgap="18.0" maxWidth="660.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="160.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="320.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            <children>
                <Label text="Id" textFill="#111827">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtId" promptText="Ejemplo: 1" GridPane.columnIndex="1" />
                <Label text="Código" textFill="#111827" GridPane.rowIndex="1">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCodigo" promptText="Ejemplo: PROD-001" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Nombre" textFill="#111827" GridPane.rowIndex="2">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombre" promptText="Ejemplo: Arroz 1 lb" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Categoría" textFill="#111827" GridPane.rowIndex="3">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="cbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccione una categoría" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Precio de Venta" textFill="#111827" GridPane.rowIndex="4">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtPrecioVenta" promptText="Ejemplo: 25.50" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Existencia" textFill="#111827" GridPane.rowIndex="5">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtExistencia" promptText="Ejemplo: 50" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="btnAdd" defaultButton="true" mnemonicParsing="false" onAction="#addOnClick" prefHeight="40.0" prefWidth="55.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../icons/agregar.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Agregar producto" />
                    </tooltip>
                </Button>
                <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#editOnClick" prefHeight="40.0" prefWidth="55.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../icons/editar.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Editar producto seleccionado" />
                    </tooltip>
                </Button>
                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#deleteOnClick" prefHeight="40.0" prefWidth="55.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../icons/eliminar.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Eliminar producto seleccionado" />
                    </tooltip>
                </Button>
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarOnClick" prefHeight="40.0" prefWidth="55.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../icons/limpiar.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Limpiar formulario" />
                    </tooltip>
                </Button>
                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolverMenuClick" prefHeight="40.0" prefWidth="55.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../icons/volver.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Volver al Menú Principal" />
                    </tooltip>
                </Button>
            </children>
            <padding>
                <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
            </padding>
            <VBox.margin>
                <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
            </VBox.margin>
        </HBox>
        <Separator />
        <Label alignment="CENTER_LEFT" maxWidth="720.0" text="Productos registrados" textFill="#1f2937">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TableView fx:id="tblProductos" prefHeight="220.0" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="Id" />
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="140.0" text="Categoría" />
                <TableColumn fx:id="colPrecioVenta" prefWidth="110.0" text="Precio Venta" />
                <TableColumn fx:id="colExistencia" prefWidth="90.0" text="Existencia" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
    <padding>
        <Insets bottom="24.0" left="36.0" right="36.0" top="20.0" />
    </padding>
</VBox>
