<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fact_app.controller.ProductoController">
   <children>
      <Label text="Módulo de Productos" textFill="#1f2937">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Formulario en desarrollo para la Fase 2" textFill="#6b7280">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Separator maxWidth="400.0" />
      <Button fx:id="btnVolverMenu" mnemonicParsing="false" onAction="#onVolverMenuClick" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Volver al Menú" />
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
